<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rhythm est sombre dans tous les cas : démarrage noir, mode clair ou
         sombre (le gabarit Flutter le laissait blanc en mode clair — à-coup
         avant le noir de l'app, leçon MyTV / Studio). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/noir</item>
    </style>
</resources>
