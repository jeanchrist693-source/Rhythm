<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde automatique et transfert d'appareil (Android 12+) : la base
     SQLite de Rhythm (app_flutter/rhythm/). Rien d'autre. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/rhythm/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/rhythm/"/>
    </device-transfer>
</data-extraction-rules>
